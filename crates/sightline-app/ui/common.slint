import { ScrollView, Palette } from "std-widgets.slint";

export enum WarningKind {
    high-nulls, looks-like-id, single-value, skewed, date-range,
    size-mismatch, bad-offsets, external-data, pickle-inside, no-statistics,
    runs-code, dangerous-import, stopped-early,
    zeros-as-missing, outliers, imbalanced, duplicate-rows, numbers-as-text,
    inconsistent-spelling, dominant-value, high-correlation,
}

export struct WarningRow {
    kind: WarningKind,
    column: string,
    first: string,
    second: string,
    third: string,
    from-sample: bool,
}

// Colors from the project template; the dark set follows the Windows theme.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> background: dark ? #0E141A : #F2F4F6;
    out property <color> surface: dark ? #151D25 : #FFFFFF;
    out property <color> surface-raised: dark ? #1D2731 : #E8ECF0;
    out property <color> text: dark ? #E4EAF0 : #16212B;
    out property <color> text-muted: dark ? #98A5B2 : #56626E;
    out property <color> line: dark ? #2A3541 : #D3DAE1;
    out property <color> accent: dark ? #E39A48 : #A9570B;
    out property <color> accent-soft: dark ? #3A2915 : #F5E6D4;
    // Accent text on accent-soft; the light accent is below 4.5:1 there.
    out property <color> accent-text: dark ? #E39A48 : #944C0A;
    out property <color> warn: dark ? #E2B252 : #9A6410;
    out property <color> warn-soft: dark ? #352914 : #F6EBD3;
    // Warn text on warn-soft; the light warn is below 4.5:1 there.
    out property <color> warn-text: dark ? #E2B252 : #85560D;
    out property <color> info: dark ? #80B1EC : #245C9E;
    out property <color> info-soft: dark ? #172A40 : #DCE7F4;
    out property <color> bad: dark ? #F07A82 : #AE2730;
    out property <color> bad-soft: dark ? #3A1A1D : #F7DEDF;
    // Column kinds: text and dates get their own colours, numbers use info.
    out property <color> kind-text: dark ? #ED93B1 : #993556;
    out property <color> kind-text-soft: dark ? #3A1A2A : #FBEAF0;
    out property <color> kind-date: dark ? #5DCAA5 : #0F6E56;
    out property <color> kind-date-soft: dark ? #10302A : #E1F5EE;
    out property <string> mono-font: "Consolas";
    out property <length> radius: 6px;
    out property <length> card-radius: 10px;
}

// Outline icons as SVG paths in a 16 × 16 box, drawn with a stroke.
export global Icons {
    out property <string> table: "M 2 3 H 14 V 13 H 2 Z M 2 6.5 H 14 M 6 6.5 V 13";
    out property <string> rows: "M 2 3.5 H 14 M 2 8 H 14 M 2 12.5 H 14";
    out property <string> statistics: "M 2 14 H 14 M 4 14 V 9 M 7 14 V 4 M 10 14 V 7 M 13 14 V 11";
    out property <string> categories: "M 2 2.5 H 6.5 V 7 H 2 Z M 9.5 2.5 H 14 V 7 H 9.5 Z M 2 9.5 H 6.5 V 14 H 2 Z M 9.5 9.5 H 14 V 14 H 9.5 Z";
    out property <string> grid: "M 2 2 H 14 V 14 H 2 Z M 6 2 V 14 M 10 2 V 14 M 2 6 H 14 M 2 10 H 14";
    out property <string> missing: "M 2 2 H 5 M 7 2 H 9 M 11 2 H 14 V 5 M 14 7 V 9 M 14 11 V 14 H 11 M 9 14 H 7 M 5 14 H 2 V 11 M 2 9 V 7 M 2 5 V 2";
    out property <string> warning: "M 8 2 L 14.5 13.5 H 1.5 Z M 8 6.5 V 9.5 M 8 11.2 V 12";
    out property <string> layers: "M 8 2 L 14 5 L 8 8 L 2 5 Z M 2 8 L 8 11 L 14 8 M 2 11 L 8 14 L 14 11";
    out property <string> overview: "M 2 2 H 14 V 14 H 2 Z M 5 5.5 H 11 M 5 8 H 11 M 5 10.5 H 8.5";
    out property <string> copy: "M 5.5 5.5 H 13.5 V 14 H 5.5 Z M 2.5 10.5 V 2 H 10.5";
    out property <string> notebook: "M 3 2 H 13 V 14 H 3 Z M 6 2 V 14 M 8.5 5.5 H 11 M 8.5 8.5 H 11";
}

export component Icon inherits Path {
    in property <string> glyph;
    in property <color> color;
    width: 14px;
    height: 14px;
    viewbox-width: 16;
    viewbox-height: 16;
    commands: root.glyph;
    stroke: root.color;
    stroke-width: 1.4px;
}

export component FormatBadge inherits Rectangle {
    in property <string> text;
    background: Theme.accent;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 2px;
        padding-bottom: 2px;

        Text {
            text: root.text;
            color: Theme.surface;
            font-family: Theme.mono-font;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

export component SampleChip inherits Rectangle {
    in property <string> text;
    background: Theme.accent-soft;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;

        Text {
            text: root.text;
            color: Theme.accent-text;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// One number of a file's header in a small card: the label above, the value below.
export component Fact inherits Rectangle {
    in property <string> value;
    in property <string> label;
    // Warnings stand out in the warn colours.
    in property <bool> caution;
    background: root.caution ? Theme.warn-soft : Theme.surface;
    border-radius: 8px;
    min-width: 72px;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        alignment: center;

        if root.label != "": Text {
            text: root.label;
            color: root.caution ? Theme.warn-text : Theme.text-muted;
            font-size: 11px;
        }

        Text {
            text: root.value;
            color: root.caution ? Theme.warn-text : Theme.text;
            font-size: 15px;
            font-weight: 600;
        }
    }
}

export component TabButton inherits Rectangle {
    in property <string> text;
    // An `Icons` path; none when empty.
    in property <string> icon;
    in property <bool> selected;
    in property <bool> show-focus;
    callback clicked;
    accessible-role: tab;
    accessible-label: root.text;
    border-radius: self.height / 2;
    border-width: root.show-focus ? 1px : 0;
    border-color: Theme.accent;
    background: root.selected ? Theme.accent-soft : area.has-hover ? Theme.surface-raised : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 6px;

        if root.icon != "": VerticalLayout {
            alignment: center;

            Icon {
                glyph: root.icon;
                color: root.selected ? Theme.accent-text : Theme.text-muted;
            }
        }

        Text {
            text: root.text;
            color: root.selected ? Theme.accent-text : Theme.text-muted;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Left and right arrow keys move between tabs once the bar has focus.
export component TabBar inherits Rectangle {
    in property <[string]> titles;
    // One `Icons` path per title; missing ones leave the tab without an icon.
    in property <[string]> icons;
    in-out property <int> current;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.current = Math.max(0, root.current - 1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.current = Math.min(root.titles.length - 1, root.current + 1);
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            alignment: start;
            padding-top: 4px;
            padding-bottom: 10px;
            spacing: 4px;

            for title[index] in root.titles: TabButton {
                text: title;
                icon: index < root.icons.length ? root.icons[index] : "";
                selected: index == root.current;
                show-focus: keys.has-focus && index == root.current;
                clicked => {
                    root.current = index;
                }
            }
        }
    }
}

export component HeaderCell inherits Text {
    color: Theme.text-muted;
    font-size: 12px;
    font-weight: 600;
    vertical-alignment: center;
    overflow: elide;
}

// "Caution" or "note" in words as well as color, so the meaning does not rely on color.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> caution;
    background: root.caution ? Theme.warn-soft : Theme.info-soft;
    border-radius: 9px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 2px;
        padding-bottom: 2px;

        Text {
            text: root.text;
            color: root.caution ? Theme.warn-text : Theme.info;
            font-size: 12px;
            font-weight: 600;
        }
    }
}

export enum ColumnKind { boolean, integer, float, decimal, date, time, date-time, text, binary, nested }

// Text that both the window and the copied summary use, so the two always match.
export global Words {
    out property <string> rows: @tr("Rows");
    out property <string> columns: @tr("Columns");
    out property <string> size: @tr("Size");
    out property <string> schema: @tr("Schema");
    out property <string> warnings: @tr("Warnings");
    out property <string> missing: @tr("missing");
    out property <string> distinct: @tr("distinct values");
    out property <string> parameters: @tr("Parameters");
    out property <string> tensors: @tr("Tensors");
    out property <string> parameters-by-type: @tr("Parameters by type");
    out property <string> shape: @tr("Shape");
    out property <string> dtype: @tr("Type");
    out property <string> min: @tr("Min");
    out property <string> max: @tr("Max");
    out property <string> nan: @tr("NaN values");
    out property <string> infinite: @tr("Infinite values");
    out property <string> protocol: @tr("Protocol");
    out property <string> imports: @tr("Imports");
    out property <string> calls: @tr("Calls");
    out property <string> dangerous: @tr("dangerous");

    public pure function at-least(count: string) -> string {
        return @tr("at least {}", count);
    }

    public pure function percent(value: string) -> string {
        return @tr("{}%", value);
    }

    public pure function kind(kind: ColumnKind) -> string {
        if kind == ColumnKind.boolean {
            return @tr("boolean");
        }
        if kind == ColumnKind.integer {
            return @tr("integer");
        }
        if kind == ColumnKind.float {
            return @tr("float");
        }
        if kind == ColumnKind.decimal {
            return @tr("decimal");
        }
        if kind == ColumnKind.date {
            return @tr("date");
        }
        if kind == ColumnKind.time {
            return @tr("time");
        }
        if kind == ColumnKind.date-time {
            return @tr("date and time");
        }
        if kind == ColumnKind.text {
            return @tr("text");
        }
        if kind == ColumnKind.binary {
            return @tr("binary");
        }
        return @tr("nested");
    }

    public pure function warning(warning: WarningRow) -> string {
        if warning.kind == WarningKind.high-nulls {
            return @tr("{0}: {1}% of the values are missing. Does an empty value mean something here, or is data missing?", warning.column, warning.first);
        }
        if warning.kind == WarningKind.looks-like-id {
            return @tr("{0}: every value is different. It is probably an ID column; do not use it as a model feature.", warning.column);
        }
        if warning.kind == WarningKind.single-value {
            return @tr("{0}: every value is \"{1}\". The column carries no information.", warning.column, warning.first);
        }
        if warning.kind == WarningKind.skewed {
            return @tr("{0}: the distribution is strongly skewed (skewness {1}).", warning.column, warning.first);
        }
        if warning.kind == WarningKind.size-mismatch {
            return @tr("The header describes a file of {0}, but the file is {1}. It may be cut short or damaged.", warning.first, warning.second);
        }
        if warning.kind == WarningKind.bad-offsets {
            return @tr("{0}: the stored bytes do not match the tensor's shape and type. The file may be damaged.", warning.column);
        }
        if warning.kind == WarningKind.external-data {
            return @tr("Tensors whose weights are kept in separate files, which Sightline does not open: {0}. Their sizes come from the shapes.", warning.first);
        }
        if warning.kind == WarningKind.pickle-inside {
            return @tr("The array holds pickled Python objects. Sightline does not read them, because loading a pickle can run code.");
        }
        if warning.kind == WarningKind.no-statistics {
            return @tr("No statistics for this type of values.");
        }
        if warning.kind == WarningKind.runs-code {
            return @tr("Loading a pickle in Python can run code. Open it only if you trust where it came from. Sightline only read its opcodes.");
        }
        if warning.kind == WarningKind.dangerous-import {
            return @tr("{0}: loading this file calls a function that can run commands or change files.", warning.column);
        }
        if warning.kind == WarningKind.zeros-as-missing {
            return @tr("{0}: {1}% of the values are 0, far below every other value. Does 0 stand for a missing measurement here?", warning.column, warning.first);
        }
        if warning.kind == WarningKind.outliers {
            return @tr("{0}: {1} values ({2}%) lie far outside the usual range ({3}).", warning.column, warning.first, warning.second, warning.third);
        }
        if warning.kind == WarningKind.imbalanced {
            return @tr("{0}: \"{1}\" makes up {2}% of the values. If this is the target, the classes are imbalanced.", warning.column, warning.first, warning.second);
        }
        if warning.kind == WarningKind.duplicate-rows {
            return @tr("{0} of {1} sample rows repeat an earlier row.", warning.first, warning.second);
        }
        if warning.kind == WarningKind.numbers-as-text {
            return @tr("{0}: {1}% of the values are numbers; the column is read as text because of values such as {2}.", warning.column, warning.first, warning.second);
        }
        if warning.kind == WarningKind.inconsistent-spelling {
            return @tr("{0}: the same value seems to be written in different ways: {1}.", warning.column, warning.first);
        }
        if warning.kind == WarningKind.dominant-value {
            return @tr("{0}: \"{1}\" makes up {2}% of the values; the column carries little information.", warning.column, warning.first, warning.second);
        }
        if warning.kind == WarningKind.high-correlation {
            return @tr("{0} and {1} move together (correlation {2}). One of them may be redundant, or give away the target.", warning.column, warning.first, warning.second);
        }
        if warning.kind == WarningKind.stopped-early {
            return @tr("Reading stopped before the end of the file, so the lists may be incomplete.");
        }
        return @tr("{0}: dates run from {1} to {2}.", warning.column, warning.first, warning.second);
    }
}

export enum CopyState { idle, copied, failed }

// Shared by every file view, so the button needs no wiring through each of them.
export global Copying {
    in-out property <CopyState> state;
    callback copy-summary();
}

export component CopyButton inherits HorizontalLayout {
    spacing: 8px;
    horizontal-stretch: 0;
    alignment: end;

    if Copying.state == CopyState.copied: Text {
        text: @tr("Summary copied");
        color: Theme.text-muted;
        font-size: 12px;
        vertical-alignment: center;
    }
    if Copying.state == CopyState.failed: Text {
        text: @tr("Could not copy the summary");
        color: Theme.bad;
        font-size: 12px;
        vertical-alignment: center;
    }

    Rectangle {
        accessible-role: button;
        accessible-label: @tr("Copy summary");
        background: area.has-hover ? Theme.accent-soft : Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.line;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 6px;

            VerticalLayout {
                alignment: center;

                Icon {
                    glyph: Icons.copy;
                    color: Theme.text-muted;
                }
            }

            Text {
                text: @tr("Copy summary");
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Copying.copy-summary();
            }
        }
    }
}

export component WarningList inherits ScrollView {
    in property <[WarningRow]> warnings;

    VerticalLayout {
        alignment: start;
        padding: 20px;
        spacing: 14px;

        if root.warnings.length == 0: Text {
            text: @tr("No warnings for this file.");
            color: Theme.text-muted;
        }

        for warning in root.warnings: HorizontalLayout {
            spacing: 10px;

            VerticalLayout {
                alignment: start;
                width: 64px;

                Pill {
                    text: root.is-caution(warning.kind) ? @tr("caution") : @tr("note");
                    caution: root.is-caution(warning.kind);
                }
            }

            Text {
                text: Words.warning(warning);
                color: Theme.text;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            if warning.from-sample: VerticalLayout {
                alignment: start;

                SampleChip {
                    text: @tr("sample");
                }
            }
        }
    }

    pure function is-caution(kind: WarningKind) -> bool {
        return kind == WarningKind.high-nulls || kind == WarningKind.single-value
            || kind == WarningKind.size-mismatch || kind == WarningKind.bad-offsets
            || kind == WarningKind.pickle-inside || kind == WarningKind.runs-code
            || kind == WarningKind.dangerous-import || kind == WarningKind.stopped-early
            || kind == WarningKind.zeros-as-missing || kind == WarningKind.duplicate-rows
            || kind == WarningKind.numbers-as-text || kind == WarningKind.inconsistent-spelling;
    }
}

export enum NotebookState { idle, saved, failed }

// "Open in notebook" with the outcome of the last click next to it.
export component NotebookButton inherits HorizontalLayout {
    in property <NotebookState> state;
    in property <string> detail;
    callback clicked;
    spacing: 8px;
    alignment: end;
    horizontal-stretch: 0;

    if root.state == NotebookState.saved: Text {
        text: @tr("Saved to {}", root.detail);
        color: Theme.text-muted;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.state == NotebookState.failed: Text {
        text: @tr("Could not create the notebook: {}", root.detail);
        color: Theme.bad;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        accessible-role: button;
        accessible-label: @tr("Open in notebook");
        background: area.has-hover ? Theme.accent-soft : Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.line;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 6px;

            VerticalLayout {
                alignment: center;

                Icon {
                    glyph: Icons.notebook;
                    color: Theme.text-muted;
                }
            }

            Text {
                text: @tr("Open in notebook");
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}

// A column's kind as a coloured badge: numbers, text and dates each have their colour.
export component KindBadge inherits Rectangle {
    in property <ColumnKind> kind;
    property <bool> number: root.kind == ColumnKind.integer || root.kind == ColumnKind.float || root.kind == ColumnKind.decimal;
    property <bool> date: root.kind == ColumnKind.date || root.kind == ColumnKind.time || root.kind == ColumnKind.date-time;
    property <bool> text: root.kind == ColumnKind.text;
    background: root.number ? Theme.info-soft : root.text ? Theme.kind-text-soft : root.date ? Theme.kind-date-soft : Theme.surface-raised;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 1px;

        Text {
            text: Words.kind(root.kind);
            color: root.number ? Theme.info : root.text ? Theme.kind-text : root.date ? Theme.kind-date : Theme.text-muted;
            font-size: 12px;
            overflow: elide;
        }
    }
}
