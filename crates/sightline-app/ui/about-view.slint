import { Theme } from "common.slint";

export enum LanguageChoice { system, turkish, english }

component ChoiceButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    background: root.selected ? Theme.accent-soft : area.has-hover ? Theme.surface-raised : Theme.surface;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.line;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 4px;
        padding-bottom: 4px;

        Text {
            text: root.text;
            color: Theme.text;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Version, license and the window language.
export component AboutView inherits Rectangle {
    in property <string> version;
    in property <LanguageChoice> language;
    callback close;
    callback language-chosen(LanguageChoice);
    background: Theme.background;

    VerticalLayout {
        alignment: center;
        padding: 32px;
        spacing: 12px;

        Text {
            text: "Sightline " + root.version;
            color: Theme.text;
            font-size: 24px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: @tr("See inside your data files without opening them.");
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: @tr("Free software under the GNU General Public License v3; Sightline's own code is also under the MIT License. Copyright 2026 Alican Kaya.");
            color: Theme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                text: @tr("Language");
                color: Theme.text-muted;
                vertical-alignment: center;
            }

            ChoiceButton {
                text: @tr("System language");
                selected: root.language == LanguageChoice.system;
                clicked => {
                    root.language-chosen(LanguageChoice.system);
                }
            }

            // Each language is named in itself, so it can be found from either one.
            ChoiceButton {
                text: "Türkçe";
                selected: root.language == LanguageChoice.turkish;
                clicked => {
                    root.language-chosen(LanguageChoice.turkish);
                }
            }

            ChoiceButton {
                text: "English";
                selected: root.language == LanguageChoice.english;
                clicked => {
                    root.language-chosen(LanguageChoice.english);
                }
            }
        }

        HorizontalLayout {
            alignment: center;

            Rectangle {
                accessible-role: button;
                accessible-label: @tr("Back");
                background: area.has-hover ? Theme.accent-soft : Theme.surface-raised;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.line;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 6px;
                    padding-bottom: 6px;

                    Text {
                        text: @tr("Back");
                        color: Theme.text;
                    }
                }

                area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}
