import { ScrollView, Spinner } from "std-widgets.slint";
import { Fact, FormatBadge, HeaderCell, NotebookButton, NotebookState, SampleChip, TabBar, Theme, WarningList, WarningRow } from "common.slint";
import { DtypeRow, IoRow, LayerRow, ModelInfo, ModelView, NamedValue, TensorRow } from "model-view.slint";
import { ArrayInfo, ArrayView } from "array-view.slint";
import { AboutView } from "about-view.slint";
import { ImportRow, PickleInfo, PickleView } from "pickle-view.slint";

export { NotebookState, WarningKind, WarningRow } from "common.slint";
export { DtypeRow, IoRow, LayerRow, ModelFormat, ModelInfo, NamedValue, SizeState, TensorRow } from "model-view.slint";
export { ArrayInfo } from "array-view.slint";
export { ImportRow, PickleInfo } from "pickle-view.slint";

export enum ViewState { empty, loading, loaded, model, array, pickle, failed }

export enum FileFormat { parquet, csv }

export enum ColumnKind { boolean, integer, float, decimal, date, time, date-time, text, binary, nested }

export enum FailureKind { not-found, permission-denied, unsupported-format, unreadable-content, other }

export struct FileInfo {
    name: string,
    size: string,
    format: FileFormat,
    row-groups: int,
    delimiter: string,
    encoding: string,
    rows: string,
    rows-exact: bool,
    columns: int,
    sampled: bool,
    sampled-rows: string,
}

export struct SchemaRow {
    name: string,
    kind: ColumnKind,
    nulls-known: bool,
    nulls-ratio: float,
    nulls-percent: string,
    bounds-known: bool,
    min: string,
    max: string,
    distinct-known: bool,
    distinct: string,
    has-histogram: bool,
    top-value: string,
    top-share: string,
}

export struct Cell {
    text: string,
    missing: bool,
}

export struct FailureInfo {
    kind: FailureKind,
    file-name: string,
    detail: string,
}

component EmptyView inherits VerticalLayout {
    in property <bool> drop-hover;
    callback show-about;
    padding: 32px;

    Rectangle {
        background: root.drop-hover ? Theme.accent-soft : Theme.surface;
        border-width: 2px;
        border-color: root.drop-hover ? Theme.accent : Theme.line;
        border-radius: 12px;

        VerticalLayout {
            alignment: center;
            padding: 24px;
            spacing: 12px;

            Text {
                text: @tr("Drop a data file here to preview it.");
                color: Theme.text;
                font-size: 20px;
                font-weight: 600;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: @tr("Sightline reads data, array and model files. The file is never changed, nothing leaves this computer, and pickles are never loaded.");
                color: Theme.text-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                FormatBadge {
                    text: "CSV";
                }

                FormatBadge {
                    text: "PARQUET";
                }

                FormatBadge {
                    text: "NPY";
                }

                FormatBadge {
                    text: "SAFETENSORS";
                }

                FormatBadge {
                    text: "ONNX";
                }

                FormatBadge {
                    text: "PKL";
                }
            }

            HorizontalLayout {
                alignment: center;

                Text {
                    text: @tr("About Sightline");
                    color: Theme.accent-text;
                    font-size: 12px;
                    accessible-role: button;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-about();
                        }
                    }
                }
            }
        }
    }
}

component LoadingView inherits VerticalLayout {
    in property <string> file-name;
    alignment: center;
    spacing: 12px;

    HorizontalLayout {
        alignment: center;

        Spinner {
            indeterminate: true;
            width: 32px;
            height: 32px;
        }
    }

    Text {
        text: @tr("Reading {}…", root.file-name);
        color: Theme.text-muted;
        horizontal-alignment: center;
    }
}

component FailureView inherits VerticalLayout {
    in property <FailureInfo> failure;
    alignment: center;
    padding: 32px;
    spacing: 10px;

    HorizontalLayout {
        alignment: center;

        Rectangle {
            background: Theme.bad-soft;
            border-radius: 4px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 2px;
                padding-bottom: 2px;

                Text {
                    text: @tr("Could not open");
                    color: Theme.bad;
                    font-size: 12px;
                    font-weight: 600;
                }
            }
        }
    }

    Text {
        text: root.message();
        color: Theme.text;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    Text {
        text: root.failure.file-name;
        color: Theme.text-muted;
        font-family: Theme.mono-font;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    Text {
        text: root.failure.detail;
        color: Theme.text-muted;
        font-size: 12px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    Text {
        text: @tr("Drop another file to try again.");
        color: Theme.text-muted;
        horizontal-alignment: center;
    }

    pure function message() -> string {
        if root.failure.kind == FailureKind.not-found {
            return @tr("The file could not be found.");
        }
        if root.failure.kind == FailureKind.permission-denied {
            return @tr("Sightline is not allowed to read this file.");
        }
        if root.failure.kind == FailureKind.unsupported-format {
            return @tr("This file type is not supported. Sightline opens CSV, Parquet, NPY, safetensors, ONNX and pickle files.");
        }
        if root.failure.kind == FailureKind.unreadable-content {
            return @tr("The file could not be read. It may be damaged, or its content may not match its name.");
        }
        return @tr("The file could not be read.");
    }
}

component FileHeader inherits Rectangle {
    in property <FileInfo> info;
    in property <NotebookState> notebook-state;
    in property <string> notebook-detail;
    callback open-notebook;
    background: Theme.surface;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        padding-bottom: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 10px;

            FormatBadge {
                text: root.info.format == FileFormat.parquet ? "PARQUET" : "CSV";
            }

            Text {
                text: root.info.name;
                color: Theme.text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            NotebookButton {
                state: root.notebook-state;
                detail: root.notebook-detail;
                clicked => {
                    root.open-notebook();
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            spacing: 20px;

            Fact {
                value: root.info.rows-exact ? root.info.rows : @tr("at least {}", root.info.rows);
                label: @tr("rows");
            }

            Fact {
                value: root.info.columns;
                label: @tr("column" | "columns" % root.info.columns);
            }

            Fact {
                value: root.info.size;
            }

            if root.info.format == FileFormat.parquet: Fact {
                value: root.info.row-groups;
                label: @tr("row group" | "row groups" % root.info.row-groups);
            }
            if root.info.format == FileFormat.csv: Fact {
                value: root.info.delimiter;
                label: @tr("delimiter");
            }
            if root.info.format == FileFormat.csv: Fact {
                value: root.info.encoding;
            }
            if root.info.sampled: VerticalLayout {
                alignment: center;

                SampleChip {
                    text: @tr("sample: {} rows", root.info.sampled-rows);
                }
            }
        }
    }
}

component NullsCell inherits HorizontalLayout {
    in property <SchemaRow> summary;
    spacing: 8px;
    alignment: start;

    if !root.summary.nulls-known: Text {
        text: "—";
        color: Theme.text-muted;
        vertical-alignment: center;
    }
    if root.summary.nulls-known: Text {
        text: @tr("{}%", root.summary.nulls-percent);
        color: Theme.text;
        width: 56px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if root.summary.nulls-known: VerticalLayout {
        alignment: center;
        width: 56px;

        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.surface-raised;

            Rectangle {
                x: 0;
                width: parent.width * Math.min(1, root.summary.nulls-ratio);
                height: parent.height;
                border-radius: 3px;
                background: Theme.warn;
            }
        }
    }
}

// A small bar chart for numbers and dates, or the most frequent value for text.
component DistributionCell inherits Rectangle {
    in property <SchemaRow> summary;
    in property <[float]> bars;
    property <length> bar-width: 7px;
    property <length> bar-gap: 2px;

    if root.summary.has-histogram: Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.bars.length * (root.bar-width + root.bar-gap);
        height: 20px;

        for ratio[index] in root.bars: Rectangle {
            x: index * (root.bar-width + root.bar-gap);
            y: parent.height - self.height;
            width: root.bar-width;
            height: ratio > 0 ? Math.max(2px, parent.height * ratio) : 0px;
            border-radius: 1px;
            background: Theme.accent;
        }
    }
    if !root.summary.has-histogram && root.summary.top-value != "": HorizontalLayout {
        spacing: 6px;

        Text {
            text: root.summary.top-value;
            color: Theme.text;
            font-family: Theme.mono-font;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: @tr("{}%", root.summary.top-share);
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
    if !root.summary.has-histogram && root.summary.top-value == "": Text {
        x: 0;
        height: parent.height;
        text: "—";
        color: Theme.text-muted;
        vertical-alignment: center;
    }
}

component SchemaTable inherits ScrollView {
    in property <[SchemaRow]> rows;
    in property <[[float]]> histograms;
    property <length> type-width: 110px;
    property <length> nulls-width: 140px;
    property <length> distinct-width: 90px;
    property <length> distribution-width: 120px;
    property <length> bound-width: 120px;

    VerticalLayout {
        alignment: start;

        Rectangle {
            background: Theme.surface-raised;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 16px;

                HeaderCell {
                    text: @tr("Column");
                    min-width: 140px;
                    horizontal-stretch: 1;
                }

                HeaderCell {
                    text: @tr("Type");
                    width: root.type-width;
                }

                HeaderCell {
                    text: @tr("Missing");
                    width: root.nulls-width;
                }

                HeaderCell {
                    text: @tr("Distinct");
                    width: root.distinct-width;
                    horizontal-alignment: right;
                }

                HeaderCell {
                    text: @tr("Distribution");
                    width: root.distribution-width;
                }

                HeaderCell {
                    text: @tr("Min");
                    width: root.bound-width;
                }

                HeaderCell {
                    text: @tr("Max");
                    width: root.bound-width;
                }
            }
        }

        for row[index] in root.rows: Rectangle {
            height: 34px;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;

                Text {
                    text: row.name;
                    color: Theme.text;
                    font-family: Theme.mono-font;
                    min-width: 140px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.kind-label(row.kind);
                    color: Theme.text-muted;
                    width: root.type-width;
                    vertical-alignment: center;
                    overflow: elide;
                }

                NullsCell {
                    summary: row;
                    width: root.nulls-width;
                }

                Text {
                    text: row.distinct-known ? row.distinct : "—";
                    color: row.distinct-known ? Theme.text : Theme.text-muted;
                    font-family: Theme.mono-font;
                    width: root.distinct-width;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                DistributionCell {
                    summary: row;
                    bars: root.histograms[index];
                    width: root.distribution-width;
                }

                Text {
                    text: row.bounds-known ? row.min : "—";
                    color: row.bounds-known ? Theme.text : Theme.text-muted;
                    font-family: Theme.mono-font;
                    width: root.bound-width;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: row.bounds-known ? row.max : "—";
                    color: row.bounds-known ? Theme.text : Theme.text-muted;
                    font-family: Theme.mono-font;
                    width: root.bound-width;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            Rectangle {
                x: 0;
                y: parent.height - self.height;
                width: parent.width;
                height: 1phx;
                background: Theme.line;
            }
        }
    }

    pure function kind-label(kind: ColumnKind) -> string {
        if kind == ColumnKind.boolean {
            return @tr("boolean");
        }
        if kind == ColumnKind.integer {
            return @tr("integer");
        }
        if kind == ColumnKind.float {
            return @tr("float");
        }
        if kind == ColumnKind.decimal {
            return @tr("decimal");
        }
        if kind == ColumnKind.date {
            return @tr("date");
        }
        if kind == ColumnKind.time {
            return @tr("time");
        }
        if kind == ColumnKind.date-time {
            return @tr("date and time");
        }
        if kind == ColumnKind.text {
            return @tr("text");
        }
        if kind == ColumnKind.binary {
            return @tr("binary");
        }
        return @tr("nested");
    }
}

component HeadTable inherits ScrollView {
    in property <[string]> titles;
    in property <[[Cell]]> rows;
    property <length> cell-width: 150px;

    VerticalLayout {
        alignment: start;

        Rectangle {
            background: Theme.surface-raised;

            HorizontalLayout {
                alignment: start;
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 16px;

                for title in root.titles: HeaderCell {
                    text: title;
                    font-family: Theme.mono-font;
                    width: root.cell-width;
                }
            }
        }

        for row[index] in root.rows: Rectangle {
            height: 30px;
            background: Math.mod(index, 2) == 1 ? Theme.background : transparent;

            HorizontalLayout {
                alignment: start;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;

                for cell in row: Text {
                    text: cell.missing ? @tr("null") : cell.text;
                    color: cell.missing ? Theme.text-muted : Theme.text;
                    font-family: Theme.mono-font;
                    font-italic: cell.missing;
                    width: root.cell-width;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

component PreviewView inherits VerticalLayout {
    in property <FileInfo> info;
    in property <[SchemaRow]> schema;
    in property <[string]> head-titles;
    in property <[[Cell]]> head-rows;
    in property <[[float]]> histograms;
    in property <[WarningRow]> warnings;
    in property <NotebookState> notebook-state;
    in property <string> notebook-detail;
    callback open-notebook;
    property <int> current-tab: 0;

    FileHeader {
        info: root.info;
        notebook-state: root.notebook-state;
        notebook-detail: root.notebook-detail;
        open-notebook => {
            root.open-notebook();
        }
    }

    TabBar {
        titles: [
            @tr("Schema"),
            @tr("First rows"),
            root.warnings.length > 0 ? @tr("Warnings ({})", root.warnings.length) : @tr("Warnings"),
        ];
        current <=> root.current-tab;
    }

    Rectangle {
        background: Theme.surface;
        vertical-stretch: 1;

        if root.current-tab == 0: SchemaTable {
            rows: root.schema;
            histograms: root.histograms;
        }
        if root.current-tab == 1: HeadTable {
            titles: root.head-titles;
            rows: root.head-rows;
        }
        if root.current-tab == 2: WarningList {
            warnings: root.warnings;
        }
    }
}

export component AppWindow inherits Window {
    icon: @image-url("icon.svg");
    in property <ViewState> state: ViewState.empty;
    in property <bool> drop-hover;
    in property <string> loading-name;
    in property <FileInfo> info;
    in property <[SchemaRow]> schema;
    in property <[string]> head-titles;
    in property <[[Cell]]> head-rows;
    in property <[[float]]> histograms;
    in property <[WarningRow]> warnings;
    in property <FailureInfo> failure;
    in property <ModelInfo> model-info;
    in property <[DtypeRow]> dtype-rows;
    in property <[NamedValue]> metadata-rows;
    in property <[IoRow]> io-rows;
    in property <[NamedValue]> operator-rows;
    in property <[LayerRow]> layer-rows;
    in property <[TensorRow]> tensor-rows;
    in property <ArrayInfo> array-info;
    in property <[float]> array-histogram;
    in property <PickleInfo> pickle-info;
    in property <[ImportRow]> import-rows;
    in property <NotebookState> notebook-state;
    in property <string> notebook-detail;
    callback open-notebook;
    in property <string> version;
    in-out property <bool> about-open;
    // Read when the shell menu is registered, so the menu uses the app's translation.
    out property <string> menu-verb: @tr("Preview with Sightline");
    // Read by the number formatting, so numbers follow the window's language.
    out property <string> decimal-separator: @tr("decimal separator" => ".");
    out property <string> thousands-separator: @tr("thousands separator" => ",");
    // Read when the tray icon is created, so its menu uses the app's translation.
    out property <string> tray-open: @tr("Open");
    out property <string> tray-start-with-windows: @tr("Start with Windows");
    out property <string> tray-about: @tr("About Sightline");
    // Read by --install and --uninstall, which report in a message box.
    out property <string> install-done: @tr("Sightline is installed. Open it from the Start menu, or right-click a data or model file in Explorer and choose Preview with Sightline.");
    out property <string> install-failed: @tr("Sightline could not be installed.");
    out property <string> uninstall-done: @tr("Sightline is removed. Your files were not touched.");
    out property <string> uninstall-failed: @tr("Sightline could not be removed completely.");
    out property <string> tray-quit: @tr("Quit");
    out property <string> tray-tip: @tr("Sightline: select a data or model file in Explorer and press Space");

    title: root.shown-name() != "" ? root.shown-name() + " — Sightline" : "Sightline";
    background: Theme.background;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    preferred-width: 1040px;
    preferred-height: 600px;
    min-width: 560px;
    min-height: 360px;

    VerticalLayout {
        if root.state == ViewState.empty: EmptyView {
            drop-hover: root.drop-hover;
            show-about => {
                root.about-open = true;
            }
        }
        if root.state == ViewState.loading: LoadingView {
            file-name: root.loading-name;
        }
        if root.state == ViewState.failed: FailureView {
            failure: root.failure;
        }
        if root.state == ViewState.loaded: PreviewView {
            info: root.info;
            schema: root.schema;
            head-titles: root.head-titles;
            head-rows: root.head-rows;
            histograms: root.histograms;
            warnings: root.warnings;
            notebook-state: root.notebook-state;
            notebook-detail: root.notebook-detail;
            open-notebook => {
                root.open-notebook();
            }
        }
        if root.state == ViewState.model: ModelView {
            info: root.model-info;
            dtypes: root.dtype-rows;
            metadata: root.metadata-rows;
            io: root.io-rows;
            operators: root.operator-rows;
            layers: root.layer-rows;
            tensors: root.tensor-rows;
            warnings: root.warnings;
            notebook-state: root.notebook-state;
            notebook-detail: root.notebook-detail;
            open-notebook => {
                root.open-notebook();
            }
        }
        if root.state == ViewState.array: ArrayView {
            info: root.array-info;
            histogram: root.array-histogram;
            warnings: root.warnings;
            notebook-state: root.notebook-state;
            notebook-detail: root.notebook-detail;
            open-notebook => {
                root.open-notebook();
            }
        }
        if root.state == ViewState.pickle: PickleView {
            info: root.pickle-info;
            imports: root.import-rows;
            warnings: root.warnings;
            notebook-state: root.notebook-state;
            notebook-detail: root.notebook-detail;
            open-notebook => {
                root.open-notebook();
            }
        }
    }

    pure function shown-name() -> string {
        if root.state == ViewState.loaded {
            return root.info.name;
        }
        if root.state == ViewState.model {
            return root.model-info.name;
        }
        if root.state == ViewState.array {
            return root.array-info.name;
        }
        if root.state == ViewState.pickle {
            return root.pickle-info.name;
        }
        return "";
    }

    if root.about-open: AboutView {
        width: 100%;
        height: 100%;
        version: root.version;
        close => {
            root.about-open = false;
        }
    }

    // Outline while a file is dragged over a window that already shows one.
    if root.drop-hover && root.state != ViewState.empty: Rectangle {
        width: 100%;
        height: 100%;
        border-width: 2px;
        border-color: Theme.accent;
    }
}
